# =====================================================================
# Atomic Decomposition Proxy — plantilla de configuración
# Copia este archivo a .env y ajusta tus valores. Todas las variables
# son opcionales: si se omiten se usa el default indicado en README.
# =====================================================================

# --- Upstream (modelo real detrás del proxy) ---
UPSTREAM_BASE_URL=http://127.0.0.1:8080/v1
UPSTREAM_API_KEY=llamacpp
UPSTREAM_MODEL=gemma4-e4b

# --- Proxy ---
PROXY_HOST=127.0.0.1
PROXY_PORT=8000
REQUEST_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO

# --- Descomposición y rondas de herramientas ---
MAX_DECOMPOSITION_DEPTH=5
MAX_TOOL_ROUNDS_PER_PHASE=25

# --- Presupuesto global de ejecución ---
#MAX_SUBTASKS_PER_NODE=6
#MAX_TOTAL_TASKS=25
#MAX_UPSTREAM_CALLS=40
#MAX_EXECUTION_SECONDS=300
#MAX_INPUT_CHARS=200000
#MAX_ACCUMULATED_CONTEXT_CHARS=300000
#MAX_PREVIOUS_RESULTS_CHARS=50000

# --- Reintentos del upstream (backoff exponencial con jitter) ---
#UPSTREAM_MAX_RETRIES=3
#UPSTREAM_RETRY_BASE_SECONDS=1
#UPSTREAM_RETRY_MAX_SECONDS=10
#UPSTREAM_MAX_RETRY_AFTER_SECONDS=30

# --- Modelos y proveedores por fase (vacío = UPSTREAM_MODEL / UPSTREAM_BASE_URL) ---
#PLANNER_MODEL=
#EXECUTOR_MODEL=
#SYNTHESIS_MODEL=
#VERIFICATION_MODEL=
#PLANNER_BASE_URL=
#EXECUTOR_BASE_URL=
#SYNTHESIS_BASE_URL=
#VERIFICATION_BASE_URL=
#PLANNER_API_KEY=
#EXECUTOR_API_KEY=
#SYNTHESIS_API_KEY=
#VERIFICATION_API_KEY=
#PLANNER_TEMPERATURE=0.0
#EXECUTOR_TEMPERATURE=0.2
#INTERNAL_MAX_TOKENS=

# --- Fast path y perfiles ---
#ATOMIC_FAST_PATH=false
#ALWAYS_SYNTHESIZE=false
#ATOMIC_PROFILE=balanced
#QUALITY_MODEL=

# --- Verificación final y paralelismo ---
#ENABLE_VERIFICATION=false
#VERIFICATION_MAX_REVISIONS=1
#ENABLE_PARALLEL_TASKS=false
#MAX_PARALLEL_TASKS=4

# --- Sesiones (pausa/reanudación) ---
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=200
#SESSION_BACKEND=memory
#SESSION_DATABASE_PATH=./data/sessions.db

# --- Multimodal (reenvío de imágenes por fase) ---
#MULTIMODAL_FORWARDING=always   # always | smart | execution_only | off

# --- Observabilidad ---
EXPOSE_REASONING_CONTENT=true
#TRACE_MODE=summary
#EXPOSE_METRICS=true
# Precios por millón de tokens en USD para estimar el coste (JSON por modelo):
#MODEL_PRICES={"deepseek-v4-flash": {"input": 0.5, "output": 2.0}}

